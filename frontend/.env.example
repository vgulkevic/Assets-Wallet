# Copy to .env.local for `npm start`. Values come from `terraform output` in backend/category-api/terraform.
# To run without AWS use `npm run start:mock` instead (mock API with the data in src/data.js).
VITE_STAGE=prod
VITE_REGION=eu-west-2
VITE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/<stage>/
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
